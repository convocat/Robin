# Copy this file to .env and fill in your own keys. Never share .env or put it on GitHub.

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Langfuse: Settings > API Keys in your Langfuse project
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional settings (these are the defaults)
ROBIN_MODEL=gpt-6-sol
COMPARE_MODEL=gpt-4.1-mini
GUARDRAIL_MODEL=gpt-6-luna
GUARDRAIL_EFFORT=low
MAX_MESSAGES_PER_CHAT=40
LANGFUSE_TRACING_ENVIRONMENT=course

# Set a passcode so only course participants can use Robin (and your OpenAI budget)
COURSE_PASSCODE=
